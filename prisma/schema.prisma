// Prisma schema for Stock & Sell
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// User
// ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")   // "user" | "admin"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  products  Product[]
  customers Customer[]
  orders    Order[]

  @@map("users")
}

// ────────────────────────────────────────────────────────────
// Category
// ────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String     @unique
  description String?

  // Self-reference for sub-categories
  parentId    String?    @db.ObjectId
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")

  // Products in this category
  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}


// ────────────────────────────────────────────────────────────
// Product
// ────────────────────────────────────────────────────────────

model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  sku               String   @unique
  categoryId        String   @db.ObjectId 
  category          Category @relation(fields: [categoryId],references: [id])

  costPrice         Float
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(10)
  imageUrl          String?  // Cloudinary URL
  imagePublicId     String? // Cloudinary public_id(for deletion)
  description       String?

  stockMovements StockMovement[]
  ownerId           String?  @db.ObjectId
  owner             User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// ────────────────────────────────────────────────────────────
// Customer
// ────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?

  ownerId   String?  @db.ObjectId
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("customers")
}

// ────────────────────────────────────────────────────────────
// Order
// ────────────────────────────────────────────────────────────

model Order {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customerName  String
  customerPhone String @default("") 
  customer      Customer @relation(fields: [customerId], references: [id])
  items         OrderItem[]

  subtotal        Float       @default(0)   // ★ sum of items before discount
  // discountType    String      @default("none")  // ★ "none" | "amount" | "percent"
  // discountValue   Float       @default(0)   // ★ the raw value (e.g. 10 for 10%, or 20 for AED 20)
  discountAmount  Float       @default(0)   // ★ computed AED discount
  total           Float                     // ★ final total after discount (what customer pays)

  status       String   @default("pending") // pending | processing | completed | cancelled
  notes        String?
  
  ownerId      String?  @db.ObjectId
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("orders")
}


// ------------------------------------------------------
// Track Historical Stock
// ------------------------------------------------------ 
model StockMovement {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Positive for stock in (purchase), Negative for stock out (sale)
  quantity     Int      
  type         String   // "sale" | "purchase" | "adjustment" | "initial"
  
  // Snapshot the cost/price at the time of movement for accurate historical calculation
  unitCost     Float?   
  unitPrice    Float?   
  
  referenceId  String?  // The orderId (if type is sale)
  notes        String?
  
  createdAt    DateTime @default(now())
  ownerId      String?  @db.ObjectId
  owner        User?    @relation(fields: [ownerId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}


// ────────────────────────────────────────────────────────────
// OrderItem  (embedded inside Order)
// ────────────────────────────────────────────────────────────

type OrderItem {
  productId       String
  productName     String
  categoryId     String   @default("")   // ★ NEW
  quantity        Int

  sellingPrice    Float      // unit selling price set by the cashier or seller
  costPrice       Float @default(0)

  discountType    String @default("none")  // "none" | "amount" | "percent" 
  discountValue   Float @default(0)        // value in AED or % , user input
  discountAmount  Float @default(0)        // computed per-unit discount in AED

}