NODE_ENV=development
PORT=5000

# For MongoDB:
DATABASE_URL="mongodb://localhost:27017/stock_sell?replicaSet=rs0"

# OR for local MongoDB without replica set (works for reads/writes, not transactions):
# DATABASE_URL="mongodb://localhost:27017/stock_sell"

# OR MongoDB Atlas:
# DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/stock_sell"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100